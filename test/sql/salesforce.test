# ================================================================ lookups (blended, LATERAL)

statement ok
SELECT * FROM read_json('{SALESFORCE_FIXTURE_URL}/__reset?t=lk');

query TTR
SELECT t.subject, o.name, o.amount FROM salesforce.main.soql('SELECT Subject, WhatId FROM Task') t, LATERAL salesforce.main.lookup(t.what_id, object_name := 'Opportunity', fields := ['Name', 'Amount']) o ORDER BY t.subject;
----
Kickoff call	Acme Platform	250000.0
Send contract	Acme Renewal	120000.5

# 3,000 rows over 8 distinct ids: deduplicated and batched (a handful of collection calls, not 3,000).
query II
SELECT count(*), count(DISTINCT o.name) FROM (SELECT (['006Dn0000000001IAA','006Dn0000000002IAA','006Dn0000000003IAA','006Dn0000000004IAA'])[1 + i % 4] AS id FROM range(3000) t(i)) t, LATERAL salesforce.main.lookup(t.id, object_name := 'Opportunity', fields := ['Name']) o;
----
3000	4

query I
SELECT count(*) <= 20 FROM read_json('{SALESFORCE_FIXTURE_URL}/__requests?t=lk') WHERE path LIKE '%/composite/sobjects/Opportunity';
----
true

# A custom-object id has no standard prefix: object_of is NULL and record() emits no row.
query I
SELECT count(*) FROM (VALUES ('a0XDn0000000001')) t(id), LATERAL salesforce.main.record(salesforce.main.object_of(t.id), t.id) r;
----
0

query TT
SELECT r.doc->>'Name', r.doc->>'Status__c' FROM (VALUES ('a0XDn0000000001')) t(id), LATERAL salesforce.main.record('Invoice__c', t.id) r;
----
INV-0001	Paid

query TTT
SELECT r.object_name, r.doc->>'Name', r.doc->>'StageName' FROM (VALUES ('006Dn0000000002'), ('006Dn0000000099')) t(id), LATERAL salesforce.main.record(salesforce.main.object_of(t.id), t.id) r ORDER BY 2 NULLS LAST;
----
Opportunity	Acme Renewal	Negotiation
Opportunity	NULL	NULL

query TTT
SELECT value, label, default_value FROM salesforce.main.picklist_values('Invoice__c', 'Status__c') ORDER BY value;
----
Draft	Draft	true
Paid	Paid	false
Sent	Sent	false
Void	Void	false

# ================================================================ replication

query T
SELECT sf_id FROM salesforce.main.updated_ids('Opportunity', TIMESTAMPTZ '2026-01-01 00:00:00+00', TIMESTAMPTZ '2026-01-08 00:00:00+00') ORDER BY sf_id;
----
006Dn0000000002IAA
006Dn0000000005IAA

query TT
SELECT sf_id, deleted_date FROM salesforce.main.deleted_ids('Opportunity', TIMESTAMPTZ '2026-01-01 00:00:00+00', TIMESTAMPTZ '2026-01-08 00:00:00+00');
----
006Dn0000000099IAA	2026-01-06 12:00:00+00

# Outside the recycle-bin retention the delete set would be incomplete: an explicit error.
statement error
SELECT * FROM salesforce.main.deleted_ids('Opportunity', TIMESTAMPTZ '2025-11-01 00:00:00+00', TIMESTAMPTZ '2026-01-08 00:00:00+00');
----
<REGEX>:.*before the earliest date.*full reload.*

# A 70-day window is split into three 30-day getUpdated requests.
statement ok
SELECT * FROM read_json('{SALESFORCE_FIXTURE_URL}/__reset?t=rep');

query I
SELECT count(*) FROM salesforce.main.updated_ids('Account', TIMESTAMPTZ '2025-11-01 00:00:00+00', TIMESTAMPTZ '2026-01-10 00:00:00+00');
----
3

query T
SELECT DISTINCT qs FROM read_json('{SALESFORCE_FIXTURE_URL}/__requests?t=rep') WHERE path LIKE '%/sobjects/Account/updated/' ORDER BY qs;
----
end=2025-12-01T00:00:00+00:00&start=2025-11-01T00:00:00+00:00
end=2025-12-31T00:00:00+00:00&start=2025-12-01T00:00:00+00:00
end=2026-01-10T00:00:00+00:00&start=2025-12-31T00:00:00+00:00
